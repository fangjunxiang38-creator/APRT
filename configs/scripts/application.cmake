config_integer(_robot_control_priority 0 31 robot control priority)
config_integer(_robot_control_stack_size 2048 16384 robot control stack_size)
config_integer(_robot_control_period_ticks 1 20 robot control period_ticks)
config_integer(_robot_input_timeout_ms 20 1000 robot remote timeout_ms)
config_integer(_robot_ps2_period_ms 10 100 robot remote ps2 poll_period_ms)
config_integer(_robot_ps2_bit_delay_us 3 20 robot remote ps2 bit_delay_us)

config_number(_deadzone 0 1 robot remote ps2 deadzone)
if(_deadzone GREATER_EQUAL 1)
    message(FATAL_ERROR "robot.remote.ps2.deadzone must be less than 1")
endif()
if(NOT _deadzone MATCHES "[.eE]")
    string(APPEND _deadzone ".0")
endif()

if(_robot_input_timeout_ms LESS _robot_ps2_period_ms)
    message(FATAL_ERROR "robot.remote.timeout_ms must be at least the PS2 polling period")
endif()

# 左前、右前、左后、右后。
config_bool(_chassis_outputs_enabled robot chassis outputs_enabled)
config_integer(_chassis_feedback_timeout_ms 10 1000 robot chassis feedback_timeout_ms)
config_integer(_chassis_current_limit 1 10000 robot chassis current_limit)
config_float(_chassis_speed_kp 0.01 10000 robot chassis speed_kp)
config_float(_chassis_speed_ki 0 10000 robot chassis speed_ki)
config_float(_chassis_speed_kd 0 10000 robot chassis speed_kd)
config_float(_chassis_max_vx 0 10 robot chassis max_vx)
config_float(_chassis_max_vy 0 10 robot chassis max_vy)
config_float(_chassis_max_wz 0 50 robot chassis max_wz)
config_float(_chassis_max_wheel_speed 0.01 500 robot chassis max_wheel_speed)
config_float(_chassis_linear_accel 0.01 100 robot chassis linear_accel)
config_float(_chassis_angular_accel 0.01 100 robot chassis angular_accel)

foreach(_key IN ITEMS wheel_radius_m half_length_m half_width_m)
    config_float(_chassis_${_key} 0 10 robot chassis ${_key})
    config_json(_distance GET robot chassis ${_key})
    if(_chassis_outputs_enabled AND _distance LESS_EQUAL 0)
        message(FATAL_ERROR "robot.chassis.${_key}: use the measured dimension before enabling outputs")
    endif()
endforeach()

foreach(_key IN ITEMS motor_ids motor_directions)
    config_json(_type TYPE robot chassis ${_key})
    config_json(_count LENGTH robot chassis ${_key})
    if(NOT _type STREQUAL "ARRAY" OR NOT _count EQUAL 4)
        message(FATAL_ERROR "robot.chassis.${_key}: expected four wheel values")
    endif()
endforeach()

set(_chassis_motor_ids "")
set(_chassis_motor_directions "")
foreach(_i RANGE 0 3)
    config_integer(_id 1 8 robot chassis motor_ids ${_i})
    if(_id IN_LIST _chassis_motor_ids)
        message(FATAL_ERROR "robot.chassis.motor_ids: duplicate C610 ID ${_id}")
    endif()
    list(APPEND _chassis_motor_ids "${_id}")

    config_number(_direction -1 1 robot chassis motor_directions ${_i})
    if(NOT _direction MATCHES "^-?1$")
        message(FATAL_ERROR "robot.chassis.motor_directions: use 1 or -1")
    endif()
    list(APPEND _chassis_motor_directions "${_direction}")
endforeach()
list(JOIN _chassis_motor_ids ", " _chassis_motor_ids)
list(JOIN _chassis_motor_directions ", " _chassis_motor_directions)
#servo
config_integer(_servo_min_us 500 2500 robot servo min_us)
config_integer(_servo_home_us 500 2500 robot servo home_us)
config_integer(_servo_max_us 500 2500 robot servo max_us)
config_float(_servo_rate_us_s 1 1000 robot servo rate_us_s)
if(_servo_min_us GREATER_EQUAL _servo_max_us OR
   _servo_home_us LESS _servo_min_us OR
   _servo_home_us GREATER _servo_max_us)
    message(FATAL_ERROR "Invalid servo limits or home pulse")
endif()